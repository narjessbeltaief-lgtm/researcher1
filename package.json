{
  "name": "dreamy-researcher",
  "version": "1.0.0",
  "description": "A lightweight, multilingual mini-VS Code for researchers, students, and coders — with one-click automatic ML researcher modules.",
  "main": "main.js",
  "author": "Dreamy Tech Researcher",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "dist:linux": "electron-builder --linux AppImage",
    "dist:win": "electron-builder --win nsis",
    "dist:mac": "electron-builder --mac dmg",
    "postinstall": "python3 -m pip install --user -r python/requirements.txt || echo 'Python deps optional — install manually if needed'"
  },
  "dependencies": {
    "monaco-editor": "^0.52.0"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.dreamytech.researcher",
    "productName": "Dreamy Researcher",
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "python/**/*",
      "node_modules/monaco-editor/min/**/*",
      "assets/**/*"
    ],
    "extraResources": [
      {
        "from": "python",
        "to": "python"
      }
    ],
    "linux": {
      "target": ["AppImage"],
      "category": "Development",
      "icon": "assets/icon.png"
    },
    "win": {
      "target": ["nsis"],
      "icon": "assets/icon.png"
    },
    "mac": {
      "target": ["dmg"],
      "category": "public.app-category.developer-tools",
      "icon": "assets/icon.png"
    }
  }
}
